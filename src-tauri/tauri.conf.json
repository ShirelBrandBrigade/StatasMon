{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StatasMon",
  "version": "0.1.0",
  "identifier": "com.statasmon.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @statasmon/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @statasmon/desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "StatasMon",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "transparent": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
